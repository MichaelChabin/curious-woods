{
  "version": 1,
  "name": "Equilateral Triangle",
  "description": "Elements I.1: a circle from each seed through the other; their crossing is the apex; the three sides; lead round them and the triangle turns to glass.",
  "operations": [
    {
      "op": "init",
      "seed0": {
        "x": -100,
        "y": 0
      },
      "seed1": {
        "x": 100,
        "y": 0
      }
    },
    {
      "op": "circle",
      "centerId": "seed:0",
      "edgeId": "seed:1"
    },
    {
      "op": "circle",
      "centerId": "seed:1",
      "edgeId": "seed:0"
    },
    {
      "op": "line",
      "p1Id": "seed:0",
      "p2Id": "seed:1"
    },
    {
      "op": "line",
      "p1Id": "seed:0",
      "p2Id": "cc:1:2:0"
    },
    {
      "op": "line",
      "p1Id": "seed:1",
      "p2Id": "cc:1:2:0"
    },
    {
      "op": "emphasize",
      "key": "3:seed:0:seed:1"
    },
    {
      "op": "emphasize",
      "key": "5:seed:1:cc:1:2:0"
    },
    {
      "op": "emphasize",
      "key": "4:seed:0:cc:1:2:0"
    },
    {
      "op": "fill",
      "fillId": "fill:1",
      "vertices": [
        "seed:0",
        "seed:1",
        "cc:1:2:0"
      ],
      "edges": [
        {
          "type": "seg",
          "a": "seed:0",
          "b": "seed:1"
        },
        {
          "type": "seg",
          "a": "seed:1",
          "b": "cc:1:2:0"
        },
        {
          "type": "seg",
          "a": "cc:1:2:0",
          "b": "seed:0"
        }
      ],
      "color": "#c2d4bc",
      "opacity": 1
    },
    {
      "op": "deemphasize",
      "key": "3:seed:0:seed:1"
    },
    {
      "op": "deemphasize",
      "key": "4:seed:0:cc:1:2:0"
    },
    {
      "op": "deemphasize",
      "key": "5:seed:1:cc:1:2:0"
    }
  ]
}
